{
    "name": "horde/cache",
    "description": "Caching library",
    "type": "horde-library",
    "homepage": "https://www.horde.org/libraries/Horde_Cache",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "psr-16"
    ],
    "time": "2026-04-01",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^3 || ^2",
        "php": "^8.1",
        "horde/compress_fast": "^2 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "psr/log": "^3.0.2",
        "ext-hash": "*"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/hashtable": "^2 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/memcache": "^3.0.0-beta1 || dev-FRAMEWORK_6_0",
        "horde/mongo": "^2 || dev-FRAMEWORK_6_0",
        "horde/support": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/hashtable": "^2 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/memcache": "^3.0.0-beta1 || dev-FRAMEWORK_6_0",
        "horde/mongo": "^2 || dev-FRAMEWORK_6_0",
        "ext-eaccelerator": "0.9.5",
        "ext-xcache": "*",
        "ext-apcu": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Cache": "lib/"
        },
        "psr-4": {
            "Horde\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Cache\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}